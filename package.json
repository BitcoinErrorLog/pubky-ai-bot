{
  "name": "pubky-ai-bot",
  "version": "1.1.0",
  "description": "Jeb — Pubky answer bot (slim runtime foundation)",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/infrastructure/database/migrations && cp src/infrastructure/database/migrations/*.sql dist/infrastructure/database/migrations/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "keygen": "tsx src/keygen.ts",
    "ingest": "tsx scripts/ingest.ts",
    "db:migrate": "node dist/infrastructure/database/migrator.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@huggingface/transformers": "^3.8.1",
    "@synonymdev/pubky": "0.6.0",
    "ai": "^4.3.16",
    "bip39": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.0",
    "pubky-app-specs": "0.4.4",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
