{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "preserveSymlinks": true,
    "paths": {
      "@pubky/bot-kit": ["packages/bot-kit/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
