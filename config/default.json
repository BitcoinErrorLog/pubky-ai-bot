{
  "server": {
    "host": "0.0.0.0",
    "port": "${PORT}",
    "cors": {
      "origin": "*",
      "credentials": false
    }
  },
  "logging": {
    "level": "${LOG_LEVEL}"
  },
  "redis": {
    "url": "${REDIS_URL}"
  },
  "postgresql": {
    "url": "${DATABASE_URL}",
    "poolSize": 10,
    "ssl": false
  },
  "pubky": {
    "network": "${PUBKY_NETWORK}",
    "homeserverUrl": "${PUBKY_HOMESERVER_URL}",
    "botMnemonic": "${PUBKY_BOT_MNEMONIC}",
    "secretKeyHex": "${PUBKY_BOT_SECRET_KEY_HEX}",
    "nexusApiUrl": "${PUBKY_NEXUS_API_URL}",
    "signupToken": "${PUBKY_SIGNUP_TOKEN}",
    "mentionPolling": {
      "enabled": true,
      "intervalSeconds": "${POLL_INTERVAL_SECONDS}",
      "batchSize": 20
    },
    "retry": {
      "cooldownSeconds": "${MENTION_RETRY_COOLDOWN_SECONDS}",
      "maxAttempts": "${MENTION_RETRY_MAX_ATTEMPTS}"
    },
    "maxRepliesPerThread": "${MAX_REPLIES_PER_THREAD}",
    "cannedReply": "${CANNED_REPLY}",
    "modelDelayMs": "${MODEL_DELAY_MS}"
  },
  "ai": {
    "primaryProvider": "${AI_PRIMARY_PROVIDER}",
    "fallbackProviders": "${AI_FALLBACK_PROVIDERS}",
    "apiKeys": {
      "openai": "${OPENAI_API_KEY}",
      "anthropic": "${ANTHROPIC_API_KEY}",
      "groq": "${GROQ_API_KEY}",
      "openrouter": "${OPENROUTER_API_KEY}"
    },
    "models": {
      "summary": "${AI_MODEL_SUMMARY}",
      "factcheck": "${AI_MODEL_FACTCHECK}",
      "classifier": "${AI_MODEL_CLASSIFIER}"
    },
    "maxTokens": {
      "summary": "${AI_MAX_TOKENS_SUMMARY}",
      "factcheck": "${AI_MAX_TOKENS_FACTCHECK}",
      "classifier": "${AI_MAX_TOKENS_CLASSIFIER}"
    },
    "classifier": {
      "temperature": "${AI_CLASSIFIER_TEMPERATURE}"
    }
  },
  "features": {
    "summary": true,
    "factcheck": true,
    "translate": false,
    "image": false
  },
  "limits": {
    "maxConcurrentActions": 4,
    "defaultTimeoutMs": 30000,
    "classifierTimeoutMs": 15000,
    "factcheckTimeoutMs": 90000,
    "thread": {
      "maxDepth": "${THREAD_MAX_DEPTH}",
      "maxPosts": "${THREAD_MAX_POSTS}",
      "maxTokensForAI": "${THREAD_MAX_TOKENS_FOR_AI}",
      "tokenWarningThreshold": "${THREAD_TOKEN_WARNING_THRESHOLD}"
    }
  },
  "safety": {
    "wordlist": [
      "banned1",
      "banned2"
    ],
    "blockOnMatch": true
  },
  "rateLimit": {
    "maxRequests": "${RATE_LIMIT_MAX_REQUESTS}",
    "windowMinutes": "${RATE_LIMIT_WINDOW_MINUTES}"
  },
  "blacklist": {
    "publicKeys": "${BLACKLIST_PUBLIC_KEYS}"
  },
  "budget": {
    "enabled": false,
    "defaultDailyTokens": 200000
  },
  "eventBus": {
    "maxAttempts": 3,
    "pendingIdleSeconds": 30
  }
}
