# Names only. Do not put real secrets in this file.

DATABASE_URL=postgres://user@127.0.0.1:5432/jeb
JEB_KNOWLEDGE_TEST_DATABASE_URL=postgres://user@127.0.0.1:5432/jeb_knowledge_unit
JEB_EVAL_DATABASE_URL=postgres://user@127.0.0.1:5432/jeb_eval
JEB_NEXUS_URL=https://nexus.staging.pubky.app
JEB_HOMESERVER=
JEB_SIGNUP_TOKEN=
JEB_BOT_PK=

# Preferred: 32-byte hex secret. Used only by --role publish / --role all.
PUBKY_BOT_SECRET_KEY_HEX=
# Optional 0600 file containing the same 64 hex chars. Loaded if HEX is unset.
PUBKY_BOT_SECRET_KEY_FILE=
# Fallback only. Derives the secret as the first 32 bytes of the BIP39 seed
# (non-standard; not BIP32 / SLIP-10). Prefer PUBKY_BOT_SECRET_KEY_HEX.
PUBKY_BOT_MNEMONIC=

JEB_CANNED_REPLY=
JEB_MODEL=gpt-4o-mini
JEB_MODEL_API_KEY=
JEB_MODEL_BASE_URL=
JEB_MODEL_TIMEOUT_MS=30000
JEB_MODEL_DELAY_MS=0
# Sampling temperature 0..2 for every model call. Unset = explicit 1.
# Moonshot kimi-k3 (JEB_MODEL_BASE_URL=https://api.moonshot.ai/v1) requires 1.
JEB_MODEL_TEMPERATURE=
JEB_DAILY_TOKEN_BUDGET=5000000
JEB_USER_DAILY_TOKEN_BUDGET=600000
# Kimi K3 family list prices (USD per 1M tokens). Used by the dashboard and docs/cost-bounds.md.
JEB_MODEL_PRICE_PER_MTOK_IN=0.6
JEB_MODEL_PRICE_PER_MTOK_OUT=2.5
JEB_MAX_REPLIES_PER_THREAD=12
JEB_MAX_PER_USER_PER_HOUR=5
JEB_MAX_AGE_MINUTES=30
JEB_POLL_MS=3000
JEB_MODEL_CACHE=
JEB_EMBED_DTYPE=q8
JEB_MODEL_LOCAL_ONLY=
JEB_BLOCKLIST=
JEB_DISABLED=0
JEB_TESTNET=0
JEB_BIND=127.0.0.1
JEB_PORT=3000
JEB_ADMIN_PORT=3001
ADMIN_TOKEN=
JEB_LOG_LEVEL=info
JEB_MAX_PUBLISH_ATTEMPTS=5
JEB_PUBLISH_STALE_MS=120000
JEB_TOOL_MAX_STEPS=4
JEB_REASON_CONCURRENCY=2
JEB_NEXUS_TIMEOUT_MS=10000
JEB_SWITCH_GLOBAL=0
JEB_SWITCH_CONSUMPTION=0
JEB_SWITCH_GENERATION=0
JEB_SWITCH_REPLIES=0
JEB_SWITCH_SCOUT=0
JEB_SWITCH_WEB=0
JEB_SWITCH_PROACTIVE=0
JEB_SWITCH_COLLECTIONS=0
# Category self-tags on Jeb's own replies (ticket 12c); 0 disables.
JEB_SELF_TAGS=1
JEB_CONTRACT_MODE=
JEB_SCOUT_URL=https://nexus-scout.pubky.app
JEB_SCOUT_ENABLED=1
JEB_SCOUT_TIMEOUT_MS=12000
JEB_SCOUT_LIMIT_MAX=50
JEB_SCOUT_RAW_ENABLED=0
JEB_SCOUT_PER_MENTION_CAP=12
JEB_SCOUT_DAILY_CEILING=400
JEB_SCOUT_RAW_PER_USER_DAILY=8
JEB_SCOUT_RAW_GLOBAL_DAILY=40
JEB_SCOUT_PROFILE_PROP_MAX=3
JEB_SCOUT_CLAIMANT_CAP=12
JEB_SCOUT_CANARY_ENABLED=true
JEB_SCOUT_CANARY_INTERVAL_MS=3600000
JEB_SCOUT_CANARY_UNKNOWN_THRESHOLD=3
JEB_SCOUT_MAX_QPS=2
# Fetch /v1/schema on reason startup and this interval (default 6h). Failures fall back to src/scout/schema.golden.json.
JEB_SCOUT_SCHEMA_REFRESH_MS=21600000
# NL query process (--role nlq). Loopback-only default.
JEB_NLQ_PORT=3014
JEB_NLQ_BIND=127.0.0.1
# Opt-in for a non-loopback bind. Warns at startup and every listen.
JEB_NLQ_BIND_DANGEROUS=
# Shared secret. Never log the value. On loopback: optional budget key
# (matching Bearer → mention_key nlq:token). On a dangerous (non-loopback)
# bind: required auth; missing or wrong Bearer → 403 unauthorized.
JEB_NLQ_TOKEN=
# Daily ceiling per nlq caller key AND globally over mention_key LIKE 'nlq:%'.
JEB_NLQ_DAILY_QUERIES=200
JEB_KNOWN_BOTS=
# Web search for research_web / evidence_map. moonshot (default) uses the
# Moonshot built-in $web_search on the same JEB_MODEL_* credentials. The
# feature is documented as "being updated"; failures return unavailable, never
# fabricated sources. brave requires JEB_BRAVE_API_KEY. off disables the tool.
JEB_WEB_PROVIDER=moonshot
JEB_BRAVE_API_KEY=
JEB_WEB_TIMEOUT_MS=45000
JEB_WEB_PER_MENTION_CAP=2
JEB_WEB_DAILY_CEILING=200
# Operator-only (scripts/profile.ts). Never run against staging before launch.
JEB_SOURCE_URL=
# After publishing content/how-i-work.json. pubky:// or https:// post URL.
# Required when passing --how-i-work to profile:publish.
JEB_HOW_I_WORK_POST_URI=
# Alias of JEB_HOW_I_WORK_POST_URI.
JEB_POLICY_URL=
JEB_PROFILE_NAME=Jeb
JEB_PROFILE_BIO=
JEB_PROFILE_STATUS=automated
# Public app origin for citation rewriting (posts/profiles). Default https://pubky.app
JEB_APP_URL=https://pubky.app
# Proactive draft lookback (days). Generators filter by real post time, not Scout indexed_at.
JEB_DRAFT_WINDOW_DAYS=7
# Skip kind:local sources even if the path exists (container-mode ingest).
JEB_SOURCES_SKIP_LOCAL=
