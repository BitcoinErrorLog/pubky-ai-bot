{
  "name": "search_web",
  "description": "Research the live web. Pro search is the default and returns cited passages with source authority. Basic returns source cards. Fetch reads only an exact URL returned earlier in this mention.",
  "parameters": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "pro",
          "basic",
          "fetch"
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "url": {
        "type": "string",
        "maxLength": 512
      },
      "recency": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "year"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20
      }
    }
  }
}
